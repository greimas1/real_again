# 사용자 코딩
library(dplyr)
df = read.csv("data/employee_performance.csv")
str(df)
colSums(is.na(df))

df$고객만족도 <- ifelse(is.na(df$고객만족도), mean(df$고객만족도, na.rm=TRUE), df$고객만족도)
df <- df %>% na.omit()

q3 <- quantile(df$고객만족도, 0.75)

print(as.integer(q3))

df <- df %>% group_by(부서) %>% summarise(평균연봉=mean(연봉), .groups="drop") %>% arrange(desc(평균연봉))

print(as.integer(df$평균연봉[2]))


